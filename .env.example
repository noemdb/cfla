
# ─── App ─────────────────────────────────────────────────────
APP_TIMEZONE=America/Caracas

# ─── OpenRouter LLM ──────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_TIMEOUT=60

# ─── NVIDIA build.nvidia.com LLM ──────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=qwen/qwen3.5-122b-a10b
NVIDIA_MAX_TOKENS=2048
NVIDIA_TEMPERATURE=0.7
NVIDIA_TIMEOUT=60

# ─── Datalab PDF API ──────────────────────────────────────────
DATALAB_API_KEY=
DATALAB_API_BASE_URL=https://www.datalab.to
DATALAB_MODE=balanced
DATALAB_TIMEOUT=300
DATALAB_POLL_INTERVAL=2
DATALAB_MAX_ATTEMPTS=3

# Palabras mínimas por bloque de //DESARROLLO para aceptar la generación
LMS_SECTION_BLOCK_MIN_WORDS=60
# Piso duro: un bloque con menos palabras se considera placeholder y rechaza
LMS_SECTION_BLOCK_HARD_FLOOR=30
# Reintentos del MISMO modelo con feedback del validador antes de pasar al siguiente
LMS_REPAIR_ATTEMPTS=1


###########################################
